rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function esSuperadmin() {
      return autenticado()
        && request.auth.uid == 'q9H2AzN2eIODDioC7auy92MpcHf2'
        && request.auth.token.email == 'superadministrador2026@gmail.com';
    }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function administraEmpresa(empresaId) {
      return esSuperadmin() || (autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().empresaId == empresaId
        && perfil().rol in ['ADMINISTRADOR', 'PROPIETARIO', 'GERENTE']);
    }
    function administraMarcacionPorId(marcacionId) {
      return esSuperadmin() || (autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().rol in ['ADMINISTRADOR', 'PROPIETARIO', 'GERENTE']
        && marcacionId.matches('^' + perfil().empresaId + '_.*$'));
    }
    function perfilMovil() {
      return get(/databases/$(database)/documents/usuariosMoviles/$(request.auth.uid)).data;
    }
    function esMovilEmpresa(empresaId) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuariosMoviles/$(request.auth.uid))
        && perfilMovil().empresaId == empresaId;
    }

    match /usuarios/{uid} {
      allow read: if esSuperadmin() || (autenticado() && request.auth.uid == uid);
      allow create: if esSuperadmin() || (autenticado()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.empresaId is string
        && request.resource.data.empresaId.matches('^EMP-[A-Z0-9-]+$')
        && request.resource.data.principal == true
        && request.resource.data.rol == 'ADMINISTRADOR'
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.fechaRegistro == request.time
        && request.resource.data.keys().hasOnly(['uid','empresaId','principal','nombre','correo','rol','estado','fechaRegistro'])
        && getAfter(/databases/$(database)/documents/companias/$(request.resource.data.empresaId)).data.empresaId == request.resource.data.empresaId);
      allow update: if esSuperadmin() || (autenticado() && request.auth.uid == uid
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.rol == resource.data.rol);
      allow delete: if esSuperadmin();
    }

    match /usuariosMoviles/{uid} {
      allow read: if esSuperadmin() || (autenticado() && request.auth.uid == uid);
      allow create: if autenticado() && request.auth.uid == uid
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.accesoId is string
        && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.accesoId)).data.correo == request.auth.token.email
        && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.accesoId)).data.empresaId == request.resource.data.empresaId
        && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.accesoId)).data.colaboradorId == request.resource.data.colaboradorId;
      allow update: if esSuperadmin();
      allow delete: if administraEmpresa(resource.data.empresaId);
    }

    match /colaboradores/{id} {
      allow read: if administraEmpresa(resource.data.empresaId)
        || (esMovilEmpresa(resource.data.empresaId)
          && id == perfilMovil().colaboradorId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /accesosMoviles/{colaboradorId} {
      allow read: if administraEmpresa(resource.data.empresaId)
        || (autenticado() && resource.data.correo == request.auth.token.email);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update: if administraEmpresa(resource.data.empresaId)
        || (autenticado()
          && resource.data.correo == request.auth.token.email
          && request.resource.data.correo == resource.data.correo
          && request.resource.data.empresaId == resource.data.empresaId
          && request.resource.data.colaboradorId == resource.data.colaboradorId
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usuarioId', 'estado', 'actualizadoEn']));
      allow delete: if administraEmpresa(resource.data.empresaId);
    }

    match /solicitudesDispositivoMovil/{id} {
      allow get: if (autenticado() && id.matches('^' + request.auth.uid + '_.*$'))
        || administraEmpresa(resource.data.empresaId)
        || (autenticado() && resource.data.usuarioId == request.auth.uid);
      allow list: if administraEmpresa(resource.data.empresaId)
        || (autenticado() && resource.data.usuarioId == request.auth.uid);
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid
        && esMovilEmpresa(request.resource.data.empresaId)
        && request.resource.data.colaboradorId == perfilMovil().colaboradorId;
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /geocercasMoviles/{id} {
      allow read: if administraEmpresa(resource.data.empresaId)
        || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /equivalenciasDniMarcaciones/{id} {
      allow read: if administraEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /marcaciones/{id} {
      allow get: if administraMarcacionPorId(id)
        || administraEmpresa(resource.data.empresaId)
        || (esMovilEmpresa(resource.data.empresaId)
          && resource.data.colaboradorId == perfilMovil().colaboradorId);
      allow list: if administraEmpresa(resource.data.empresaId)
        || (esMovilEmpresa(resource.data.empresaId)
          && resource.data.colaboradorId == perfilMovil().colaboradorId);
      allow create: if administraEmpresa(request.resource.data.empresaId)
        || (esMovilEmpresa(request.resource.data.empresaId)
          && request.resource.data.colaboradorId == perfilMovil().colaboradorId
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.origen == 'MOVIL'
          && (request.resource.data.sucursalId == null
            || request.resource.data.sucursalId is string)
          && request.resource.data.ubicacion.latitud is number
          && request.resource.data.ubicacion.longitud is number
          && request.resource.data.ubicacion.dentroZona == true
          && request.resource.data.geocerca.dentroZona == true
          && request.resource.data.fechaHora == request.time
          && request.resource.data.creadoEn == request.time
          && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.colaboradorId)).data.usuarioId == request.auth.uid
          && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.colaboradorId)).data.estado == 'AUTORIZADO'
          && get(/databases/$(database)/documents/accesosMoviles/$(request.resource.data.colaboradorId)).data.dispositivoAutorizadoId == request.resource.data.dispositivoId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /sucursales/{id} {
      allow read: if administraEmpresa(resource.data.empresaId) || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /horarios/{id} {
      allow read: if administraEmpresa(resource.data.empresaId) || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /asignacionesHorarios/{id} {
      allow read: if administraEmpresa(resource.data.empresaId) || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /excepcionesHorarios/{id} {
      allow read: if administraEmpresa(resource.data.empresaId) || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /permisos/{id} {
      allow read: if administraEmpresa(resource.data.empresaId)
        || (esMovilEmpresa(resource.data.empresaId)
          && resource.data.colaboradorId == perfilMovil().colaboradorId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /companias/{empresaId} {
      allow create: if autenticado()
        && empresaId.matches('^EMP-[A-Z0-9-]+$')
        && request.resource.data.empresaId == empresaId
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.fechaRegistro == request.time
        && request.resource.data.fechaSolicitud == request.time
        && request.resource.data.empresa.ruc is string
        && request.resource.data.empresa.ruc.matches('^[0-9]{11}$')
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMINISTRADOR'
        && getAfter(/databases/$(database)/documents/indicesRuc/$(request.resource.data.empresa.ruc)).data.uid == request.auth.uid;
      allow read, update, delete: if administraEmpresa(resource.data.empresaId);
    }

    match /sesionesSistema/{id} {
      allow read: if esSuperadmin() || administraEmpresa(resource.data.empresaId);
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid
        && administraEmpresa(request.resource.data.empresaId);
      allow update: if autenticado()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.empresaId == resource.data.empresaId
        && administraEmpresa(resource.data.empresaId);
      allow delete: if esSuperadmin();
    }

    match /configuracionSuperadmin/{id} {
      allow read, write: if esSuperadmin();
    }

    match /indicesRuc/{id} {
      allow get: if autenticado();
      allow list: if esSuperadmin();
      allow create: if esSuperadmin() || (autenticado()
        && id.matches('^[0-9]{11}$')
        && request.resource.data.valor == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo == 'EMPRESA'
        && request.resource.data.empresaId is string
        && request.resource.data.empresaId.matches('^EMP-[A-Z0-9-]+$')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly(['valor','empresaId','tipo','uid','creadoEn'])
        && getAfter(/databases/$(database)/documents/companias/$(request.resource.data.empresaId)).data.empresa.ruc == id);
      allow update, delete: if esSuperadmin();
    }

    match /indicesCorreo/{id} {
      allow get: if autenticado() && (id == request.auth.token.email || esSuperadmin());
      allow list: if esSuperadmin();
      allow create: if esSuperadmin() || (autenticado()
        && id == request.auth.token.email
        && request.resource.data.valor == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo == 'ADMINISTRADOR_PRINCIPAL'
        && request.resource.data.empresaId is string
        && request.resource.data.empresaId.matches('^EMP-[A-Z0-9-]+$')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly(['valor','empresaId','tipo','uid','creadoEn'])
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.correo == id);
      allow update, delete: if esSuperadmin();
    }

    match /auditoriaSuperadmin/{id} {
      allow read, create: if esSuperadmin();
      allow update: if false;
      allow delete: if esSuperadmin();
    }

    // Comunicados: los administradores gestionan; cada móvil solo lee los de su empresa.
    match /anunciosEmpresa/{id} {
      allow read: if administraEmpresa(resource.data.empresaId)
        || esMovilEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update: if administraEmpresa(resource.data.empresaId)
        && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if administraEmpresa(resource.data.empresaId);
    }

    // La bitácora es append-only: puede consultarse y agregarse, nunca reescribirse o borrarse.
    match /auditoriaSistema/{id} {
      allow read: if administraEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update: if false;
      allow delete: if esSuperadmin();
    }

    match /historialOperacionesAsistencia/{id} {
      allow read: if administraEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update: if false;
      allow delete: if esSuperadmin();
    }

    match /mail/{id} {
      allow read, delete: if esSuperadmin();
      allow create, update: if false;
    }
    match /desafiosMoviles/{id} { allow read, write: if false; }

    match /{coleccion}/{id} {
      allow read: if administraEmpresa(resource.data.empresaId);
      allow create: if administraEmpresa(request.resource.data.empresaId);
      allow update: if administraEmpresa(resource.data.empresaId)
        && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if administraEmpresa(resource.data.empresaId);
    }
  }
}
